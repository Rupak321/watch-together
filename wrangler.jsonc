{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch-together",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Uploads are off until R2 is switched on, because a binding naming a
  // bucket that does not exist blocks every deploy, not just uploading.
  //
  // To turn them on:
  //   1. dash.cloudflare.com -> R2 -> enable it on the account (one time)
  //   2. npx wrangler r2 bucket create watch-together-media
  //   3. uncomment the block below
  //   4. npx wrangler deploy
  //
  // R2 has zero egress fees at every tier; the free limit is 10 GB stored.
  // Everything else — sync, voice, screen share, chat — works without it.
  //
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "watch-together-media" }
  // ],

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },

  // SQLite-backed Durable Objects are the only kind available on the free plan.
  // Using "new_classes" here would work locally and fail on deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],

  "observability": { "enabled": true }
}
